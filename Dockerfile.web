# Build stage
FROM oven/bun:1.4.2 AS builder

WORKDIR /app

# Copy root package files, lockfile, and base tsconfig
COPY package.json bun.lock turbo.json tsconfig.base.json ./

# Copy ALL package.json files first (needed for workspace resolution)
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY apps/desktop/package.json ./apps/desktop/
COPY apps/mobile/package.json ./apps/mobile/
COPY packages/database/package.json ./packages/database/
COPY packages/types/package.json ./packages/types/
COPY packages/utils/package.json ./packages/utils/
COPY packages/api-client/package.json ./packages/api-client/
COPY mcp/package.json ./mcp/

# Install dependencies (allow lockfile updates for cross-platform compatibility)
RUN bun install

# Copy source code for packages we need to build
COPY packages/types/ ./packages/types/
COPY packages/utils/ ./packages/utils/
COPY packages/api-client/ ./packages/api-client/
COPY apps/web/ ./apps/web/

# Optional: bake the API URL into the JavaScript. Leave empty for an image that
# works anywhere; server.ts then hands the browser API_URL (and WS_URL) from the
# container's environment at runtime via /config.js. That is what the published
# images and docker-compose.yml do.
ARG VITE_API_URL=""
ARG VITE_WS_URL=""
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_WS_URL=$VITE_WS_URL

# Build the packages and web app
RUN bun run build --filter=@open-sunsama/types --filter=@open-sunsama/utils --filter=@open-sunsama/api-client --filter=@open-sunsama/web

# Bundle the server with its dependencies; the production stage has no node_modules
RUN bun build apps/web/server.ts --target=bun --outfile=apps/web/server.js

# Production stage - serve static files
FROM oven/bun:1.4.2-slim

WORKDIR /app

# Copy built static files and the server from builder
COPY --from=builder /app/apps/web/dist ./dist
COPY --from=builder /app/apps/web/server.js ./server.js

# Expose port
ENV PORT=3000
EXPOSE 3000

# Static server with SPA fallback that serves pre-rendered blog pages. Set
# API_URL when starting the container (WS_URL too, if the WebSocket lives
# elsewhere): docker run -e API_URL=https://api.tasks.example.com ...
CMD ["bun", "run", "server.js"]
